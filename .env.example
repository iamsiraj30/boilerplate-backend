PORT=3000
NODE_ENV=development

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tprice_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tprice_db?schema=public"

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5050"

# pgAdmin 4 Configuration
PGADMIN_DEFAULT_EMAIL=admin@tprice.com
PGADMIN_DEFAULT_PASSWORD=admin

